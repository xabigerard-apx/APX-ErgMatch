<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="purpleGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#613795"/>
    </linearGradient>
  </defs>

  <rect width="512" height="512" rx="115" fill="#000000"/>
  <rect width="504" height="504" x="4" y="4" rx="111" fill="none" stroke="#22222a" stroke-width="4"/>

  <!-- Pales de la turbine cardio en rotation -->
  <g transform="translate(256, 225)">
    <!-- Anneau de vitesse extérieur segmenté -->
    <circle cx="0" cy="0" r="145" fill="none" stroke="#1f1f28" stroke-width="8" stroke-dasharray="14 10"/>
    <circle cx="0" cy="0" r="125" fill="none" stroke="url(#purpleGrad1)" stroke-width="12" stroke-dasharray="65 20"/>

    <!-- Pales / Blades -->
    <path d="M 0 -115 L 20 -40 L -20 -40 Z" fill="url(#purpleGrad1)" opacity="0.9"/>
    <path d="M 0 -115 L 20 -40 L -20 -40 Z" fill="url(#purpleGrad1)" opacity="0.9" transform="rotate(60)"/>
    <path d="M 0 -115 L 20 -40 L -20 -40 Z" fill="url(#purpleGrad1)" opacity="0.9" transform="rotate(120)"/>
    <path d="M 0 -115 L 20 -40 L -20 -40 Z" fill="url(#purpleGrad1)" opacity="0.9" transform="rotate(180)"/>
    <path d="M 0 -115 L 20 -40 L -20 -40 Z" fill="url(#purpleGrad1)" opacity="0.9" transform="rotate(240)"/>
    <path d="M 0 -115 L 20 -40 L -20 -40 Z" fill="url(#purpleGrad1)" opacity="0.9" transform="rotate(300)"/>

    <!-- Moyeu central -->
    <circle cx="0" cy="0" r="42" fill="#09090b" stroke="#33333f" stroke-width="4"/>
    <!-- Éclair d'énergie central -->
    <path d="M -8 -18 L 10 -4 L 0 2 L 8 18 L -10 4 L 0 -2 Z" fill="#ffffff"/>
  </g>

  <!-- Marquage APX SCALE -->
  <text x="256" y="420" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Arial Black', sans-serif" font-size="52" font-weight="900" letter-spacing="8" fill="#ffffff">APX</text>
  <text x="256" y="455" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="16" font-weight="800" letter-spacing="6" fill="#a855f7">CARDIO</text>
</svg>
